# Copie este arquivo para ".env" e ajuste os valores reais antes de gerar
# uma ISO para uso real. O ".env" NAO deve ser commitado (ja esta no
# .gitignore) - e onde ficam a senha de root/suporte e os dados do AD que
# nao devem existir em texto puro no repositorio (publico).

# Senha da conta root local (usada tambem para o usuario "suporte").
ROOT_PASSWORD=TROQUE_ESSA_SENHA
SUPORTE_PASSWORD=TROQUE_ESSA_SENHA

# Dominio do Active Directory (FQDN) e usuario com permissao de join.
AD_DOMAIN=seudominio.local
AD_ADMIN_USER=admin_user

# Opcional: restringe login SSH/local a um grupo especifico do AD.
# Deixe vazio para permitir todos os usuarios do dominio.
AD_ALLOWED_GROUP=
